# Copy to .env.local and fill in.
#
# The AI Interview Simulator uses Claude when this key is present.
# WITHOUT a key, the app still runs — it falls back to a built-in scripted
# officer so every feature works offline (see lib/scripted.ts).
ANTHROPIC_API_KEY=

# Model used by the AI officer and feedback grader.
# Defaults to claude-opus-4-8 if unset.
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Optional: database (not required to run) ----
# The app persists progress in the browser (localStorage) out of the box.
# To wire up Postgres via Prisma + Supabase later, see prisma/schema.prisma
# and set:
# DATABASE_URL=
